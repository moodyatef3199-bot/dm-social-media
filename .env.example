# ============================================================
# DREAMS MARKET — Environment Variables
# Copy to .env.local for local development
# Add to Vercel Dashboard for production
# ============================================================

# Supabase — get from app.supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...YOUR_ANON_KEY

# Supabase Service Role (for admin user management — optional)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...YOUR_SERVICE_ROLE_KEY

# Anthropic AI — get from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE

# App
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
